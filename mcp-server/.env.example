# NexusComm MCP Server - .env Configuration Template

# NexusComm Backend Configuration
NEXUSCOMM_API_URL=http://localhost:3000
NEXUSCOMM_API_KEY=your_nexuscomm_api_key_here
NEXUSCOMM_USER_ID=your_user_id_here

# Local System Access Configuration
ENABLE_FILE_SYSTEM=true
ALLOWED_PATHS=/Users/allansmeyatsky/Documents,/Users/allansmeyatsky/Downloads,/Users/allansmeyatsky/Desktop
ENABLE_SHELL_ACCESS=false
ENABLE_BROWSER_CONTROL=false

# AI/LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_DEFAULT_MODEL=claude-3-sonnet-20240229
AI_MAX_TOKENS=4096

# Logging Configuration
LOG_LEVEL=info

# MCP Server Configuration
MCP_SERVER_NAME=nexuscomm-mcp-server
MCP_SERVER_VERSION=1.0.0